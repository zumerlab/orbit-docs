---
const isHomepage = Astro.locals.starlightRoute.id === '';
import EditLink from '@astrojs/starlight/components/EditLink.astro';
import LastUpdated from '@astrojs/starlight/components/LastUpdated.astro';
import Pagination from './CustomPagination.astro';
import { LinkButton } from '@astrojs/starlight/components';
---

<footer>
	{!isHomepage && (
	<div class="meta sl-flex">
		<EditLink />
		<LastUpdated />
	</div>
	<div class="metaz sl-flex">
		<LinkButton
			href="https://github.com/zumerlab/orbit"
			variant="secondary"
			icon="github"
			iconPlacement="start">
			Place your ⭐ in Orbit!
		</LinkButton>

	</div>
	<Pagination />
    )}
</footer>

<style>
	.meta {
		gap: 0.75rem 3rem;
		justify-content: space-between;
		flex-wrap: wrap;
		margin-block: 3rem 1.5rem;
		font-size: var(--sl-text-sm);
		color: var(--sl-color-gray-3);
	}
	.meta > :global(p:only-child) {
		margin-inline-start: auto;
	}
	.metaz {
		gap: 0.75rem 3rem;
		justify-content: center;
		
		margin-block: 3rem 1.5rem;
		font-size: var(--sl-text-sm);
		color: var(--sl-color-gray-3);
	}
	.metaz > :global(p:only-child) {
		margin-inline-start: auto;
	}
</style>
