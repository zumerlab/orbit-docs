---
// This site documents Orbit 1.x. Every page points to Orbit 2 and its
// migration guide. The home page has its own, larger notice (OrbitHero.astro).
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const isHome = Astro.url.pathname.replace(/\/$/, '') === base;
---
{!isHome && <div class="v1-banner">
  <strong>Orbit 2 is out</strong>, with Orbit Kit 2 and a new site:
  <a href="https://zumerlab.com/orbit/">read the Orbit 2 docs</a> or see
  <a href="https://zumerlab.com/orbit/migrating.html">what changed</a>. These docs stay here for Orbit 1.x.
</div>}

<style>
  .v1-banner {
    padding: 0.5rem 1rem;
    background: var(--sl-color-orange-low);
    color: var(--sl-color-orange-high);
    text-align: center;
    font-size: var(--sl-text-sm);
  }
  .v1-banner strong { font-weight: 600; }
  .v1-banner a { color: inherit; font-weight: 600; }
</style>
