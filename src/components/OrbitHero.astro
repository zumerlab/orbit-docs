---
import '../assets/orbit.min.css';
import '../styles/orbit-home.css';
import OrbitPlayground from './OrbitPlayground.astro';
import orbitLogo from '../assets/dark-orbit.svg?url';
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const docs = (path: string) => `${base}${path}`;
---

<div class="orbit-home not-content" id="orbit-home">
  <header class="home-header home-width">
    <a class="home-wordmark" href={base} aria-label="Orbit home"><img src={orbitLogo} width="44" height="33" alt=""/><span>Orbit</span></a>
    <nav aria-label="Main navigation"><a href="#playground">Playground</a><a href="#examples">Examples</a><a href={docs('introduction/')}>Docs</a><a href="https://github.com/zumerlab/orbit" class="github-link">GitHub <span aria-hidden="true">↗</span></a></nav>
  </header>
  <section class="home-hero home-width" aria-labelledby="_top">
    <div class="hero-copy">
      <h1 id="_top" tabindex="-1">Build interfaces <br/>around <em>a center.</em></h1>
      <p class="hero-description">Compose menus, charts and instruments with HTML and CSS. Orbit keeps the geometry in place as your interface changes.</p>
      <div class="home-actions"><a class="home-button primary" href="#playground">Try the playground <span aria-hidden="true">↗</span></a><a class="home-text-link" href={docs('introduction/installation/')}>Get started <span aria-hidden="true">→</span></a></div>
      <p class="hero-footnote">Works with React, Vue, Svelte and plain HTML.</p>
    </div>
    <div class="hero-composition">
      <div class="hero-art bigbang" id="hero-art" role="img" aria-label="An Orbit composition with 6 satellites">
        <div class="gravity-spot hero-gyro" id="hero-gyro">
          <div class="orbit-14 hero-outer"><o-arc value="68" style="--o-fill:#3da9fc;--o-stroke:none;--o-size-ratio:.13;--o-from:110deg"></o-arc></div>
          <div class="orbit-12 hero-ticks">{Array.from({length:48}, (_, index) => <div class="vector" style={`opacity:${index % 4 === 0 ? '.8' : '.3'}`}></div>)}</div>
          <div class="orbit-10 hero-ring" id="hero-points">{Array.from({length:6}, (_, index) => <div class="satellite"><div class="capsule hero-point">{index + 1}</div></div>)}</div>
          <div class="orbit-8 hero-blue-arc"><o-arc value="58" style="--o-fill:#3da9fc;--o-stroke:none;--o-size-ratio:.6;--o-from:200deg"></o-arc></div>
          <div class="orbit-7 hero-pink-arc"><o-arc value="38" style="--o-fill:#ef4565;--o-stroke:none;--o-size-ratio:.42;--o-from:35deg"></o-arc></div>
          <div class="orbit-5 hero-inner-arc"><o-arc value="22" style="--o-fill:#3da9fc;--o-stroke:none;--o-size-ratio:1.15;--o-from:220deg;opacity:.3"></o-arc></div>
          <div class="orbit-0"><div class="satellite at-center"><div class="capsule hero-core"><img src={orbitLogo} width="44" height="33" alt=""/><strong>Orbit</strong></div></div></div>
        </div>
      </div>
      <div class="hero-live-controls">
        <label for="hero-count">Satellites <output id="hero-count-out" for="hero-count">6</output></label><input id="hero-count" type="range" min="3" max="16" value="6"/>
        <button type="button" id="hero-motion" aria-pressed="false" aria-label="Animate the Orbit composition" hidden><svg aria-hidden="true" viewBox="0 0 20 20"><path class="motion-play" d="M7 4 16 10 7 16Z"/><path class="motion-pause" d="M5 4h3v12H5zm7 0h3v12h-3z"/></svg><span>Animate</span></button>
      </div>
      <p class="hero-caption"><a href={docs('examples/scifi/')}>See how the 3D effect works <span aria-hidden="true">→</span></a></p>
    </div>
  </section>

  <section class="home-lab-section home-width" aria-label="Interactive Orbit playground">
    <OrbitPlayground />
  </section>

  <section class="home-examples home-width" id="examples" aria-labelledby="examples-title">
    <div class="home-section-heading"><div><h2 id="examples-title">Examples</h2></div><a class="home-text-link" href={docs('examples/progress/')}>Explore the docs <span aria-hidden="true">↗</span></a></div>
    <div class="example-grid">
      <article class="example-item">
        <div class="example-art bigbang" role="img" aria-label="Eight items arranged as a radial menu"><div class="gravity-spot"><div class="orbit-6 example-guide">{['1','2','3','4','5','6','7','8'].map(label => <div class="satellite"><div class="capsule example-node">{label}</div></div>)}</div><div class="orbit-0"><div class="satellite at-center"><div class="capsule example-center">Menu</div></div></div></div></div>
        <p class="example-kind">Satellites</p><h3>Radial menu</h3><p>Arrange actions around a focal point. Change the count, range and starting angle.</p><button type="button" data-orbit-recipe="satellites" class="home-text-link">Edit this example <span aria-hidden="true">↗</span></button>
      </article>
      <article class="example-item">
        <div class="example-art bigbang" role="img" aria-label="A donut chart with segments of 40 and 25 percent"><div class="gravity-spot"><div class="orbit-6"><o-arc value="100" style="--o-fill:#1e3644;--o-stroke:none;--o-gap:0"></o-arc></div><div class="orbit-6"><o-arc value="40" style="--o-fill:#3da9fc;--o-stroke:none;--o-gap:2"></o-arc><o-arc value="25" style="--o-fill:#ef4565;--o-stroke:none;--o-gap:2"></o-arc></div><div class="orbit-0"><div class="satellite at-center"><div class="capsule example-center">Data</div></div></div></div></div>
        <p class="example-kind">Arcs</p><h3>Donut chart</h3><p>Compose a chart from values. Following segments move when the data changes.</p><button type="button" data-orbit-recipe="arcs" class="home-text-link">Edit this example <span aria-hidden="true">↗</span></button>
      </article>
      <article class="example-item">
        <div class="example-art bigbang" role="img" aria-label="A progress gauge showing 63 percent"><div class="gravity-spot"><div class="orbit-6" style="--o-range:270deg;--o-from:225deg"><o-progress value="63" shape="rounded" style="--o-fill:#3da9fc;--o-stroke:none;--o-back-fill:#1e3644;--o-size-ratio:1.6"></o-progress></div><div class="orbit-0"><div class="satellite at-center"><div class="capsule example-center gauge-label">63<span>%</span></div></div></div></div></div>
        <p class="example-kind">Progress</p><h3>Progress gauge</h3><p>Build indicators and instrument faces. Set the opening, fill and shape.</p><button type="button" data-orbit-recipe="progress" class="home-text-link">Edit this example <span aria-hidden="true">↗</span></button>
      </article>
    </div>
  </section>
  <section class="home-kit home-width" aria-labelledby="kit-title"><div><h2 id="kit-title">Ready-made components with Orbit Kit</h2><p>Add gauges, clocks, knobs and radial menus with custom HTML elements.</p></div><a class="home-button secondary" href="https://zumerlab.com/orbit-kit">Explore Orbit Kit <span aria-hidden="true">↗</span></a></section>
  <section class="home-start home-width" aria-labelledby="start-title"><div><h2 id="start-title">Use Orbit in your project</h2><p>Download a complete HTML file from the playground, or follow the installation guide to add Orbit to your app.</p><a class="home-button primary" href={docs('introduction/installation/')}>Installation guide <span aria-hidden="true">→</span></a></div><div class="home-learning-links"><a href={docs('introduction/')}><span>Understand the structure</span><small>Containers, rings and the elements that live on them.</small><b aria-hidden="true">↗</b></a><a href={docs('elements/orbit/')}><span>Explore the layout API</span><small>Control the radius, range, direction and spacing.</small><b aria-hidden="true">↗</b></a><a href={docs('integrations/react/')}><span>Use your framework</span><small>Compose with React, Vue, Svelte or plain HTML.</small><b aria-hidden="true">↗</b></a></div></section>
  <footer class="home-footer home-width"><a class="footer-brand" href={base}>Orbit <span>by Zumerlab</span></a><span>Open source · MIT</span><a href="https://github.com/zumerlab/orbit">GitHub</a><a href={docs('introduction/')}>Documentation</a><a href="https://zumerlab.com/">Zumerlab <span aria-hidden="true">↗</span></a></footer>
</div>
<script is:inline defer src={`${base}orbit/orbit.min.js`}></script>
<script>import '../scripts/orbit-home';</script>
