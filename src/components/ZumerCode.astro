---
interface Props {
  name?: string
  htmlCode?: string
  cssCode?: string
  jsCode?: string
  hideCode?: boolean
  theme?: string
  height?: string
  framework: 'vanilla' | 'react' | 'vue' | 'svelte'
  frameTemplate: 'orbit' | 'barebone'
}

import "prism-code-editor/themes/github-dark.css"
import "prism-code-editor/copy-button.css"
import "prism-code-editor/layout.css"
import "prism-code-editor/scrollbar.css"

import { Tabs, TabItem } from '@astrojs/starlight/components';
const siteBase = import.meta.env.BASE_URL.replace(/\/$/, '');
const orbitCSSUrl = `${siteBase}/orbit/orbit.min.css`;
const orbitJSUrl = `${siteBase}/orbit/orbit.min.js`;
const editorBase = `${siteBase}/prism-code-editor/dist`;
const installationUrl = `${siteBase}/introduction/installation/`;


const { htmlCode = 'No HTML provided', cssCode, jsCode, name = 'zumer', hideCode = false, theme= '', height='300px', framework='vanilla', frameTemplate='orbit'} = Astro.props

let htmlClass = `html-${name}`
let cssClass = `css-${name}`
let jsClass = `js-${name}`
---

<div id={name} class="container not-content" style={{height: height}}>
  <div class="preview">
    <div class="codeRenderer">
      <!-- The editor renders each example in an isolated document. -->
    </div>
  </div>
</div>
<p class="runtime-note">Examples include the current Orbit stylesheet and runtime. <a href={installationUrl}>Get both files for your project.</a></p>
<Tabs>
  {!hideCode && htmlCode && 
  <TabItem label="HTML" icon="seti:html" >
    <div class:list={[htmlClass, "zeditor", "not-content"]}></div>
  </TabItem>
  }
  {!hideCode && cssCode && 
    <TabItem label="CSS" icon="seti:css" >
    <div class:list={[cssClass, "zeditor", "not-content"]}></div>
  </TabItem>
  }
  {!hideCode && (framework !== 'vanilla' || jsCode) &&
    <TabItem label={framework !== 'vanilla' ? framework : 'Js'}  icon={`seti:${framework === 'vanilla' ? 'javascript' : framework}`} >
      <div class:list={[jsClass, "zeditor", "not-content"]}></div>
    </TabItem>
    }
  
</Tabs>
<script></script>
<script type="module" is:inline define:vars={
  {htmlCode, 
  cssCode, 
  jsCode,
  framework, 
  hideCode, 
  height,
  theme, 
  name, 
  orbitCSSUrl,
  orbitJSUrl,
  editorBase,
  htmlClass, 
  cssClass, 
  jsClass, 
  frameTemplate,
  
}
  }>

const [
  { createEditor: createPrismEditor, isWebKit }, { copyButton }, { matchBrackets }, { indentGuides },
  { highlightBracketPairs }, { matchTags }, { defaultCommands, editHistory }
] = await Promise.all([
  import(`${editorBase}/index.js`),
  import(`${editorBase}/extensions/copyButton/index.js`),
  import(`${editorBase}/extensions/matchBrackets/index.js`),
  import(`${editorBase}/extensions/guides.js`),
  import(`${editorBase}/extensions/matchBrackets/highlight.js`),
  import(`${editorBase}/extensions/matchTags.js`),
  import(`${editorBase}/extensions/commands.js`),
]);
await Promise.all([
  'prism/languages/markup.js', 'prism/languages/css.js', 'prism/languages/javascript.js',
  'languages/html.js', 'languages/css.js', 'languages/clike.js',
].map((path) => import(`${editorBase}/${path}`)));

function createEditor(...args) {
  const editor = createPrismEditor(...args);
  editor.textarea.setAttribute('aria-label', `${name} ${editor.options.language} source`);
  if (isWebKit) {
    // Prism 3.4 queues a one-time focus restoration while setting its initial
    // value. In WebKit that handler can consume the user's first focus instead.
    // Complete that first focus after Prism's handler, without focusing on load
    // or scrolling the page. This also covers keyboard entry into hidden tabs.
    editor.textarea.addEventListener('focus', () => {
      queueMicrotask(() => {
        if (editor.textarea.isConnected && document.activeElement !== editor.textarea) {
          editor.textarea.focus({ preventScroll: true });
        }
      });
    }, { once: true });
  }
  return editor;
}



  let frame = frameworkSnippet (framework)
   
  let _HTML = frame && frame.html ? frame.html : htmlCode
  let _CSS = cssCode
  let _JS = frame && frame.app ? frame.app : jsCode

  !hideCode && htmlCode && createEditor(
    `.${htmlClass}`,
    {
      language: "html",
      value: `${_HTML.trim()}`,
      theme: "github-dark",
      onUpdate(editedHTML) {
        _HTML = editedHTML
        updateIframe()
      }
    },
    highlightBracketPairs(),
    matchTags(),
    defaultCommands(),
    matchBrackets(),
    indentGuides(),
    copyButton(),
    editHistory(),
  )
  
  !hideCode && cssCode &&
  createEditor(
    `.${cssClass}`,
    {
      language: "css",
      value: `${_CSS.trim()}`,
      theme: "github-dark",
      onUpdate(editedCSS) {
        _CSS = editedCSS
        updateIframe()
      }
    },
    highlightBracketPairs(),
    matchTags(),
    defaultCommands(),
    matchBrackets(),
    indentGuides(),
    copyButton(),
    editHistory(),
  )

  !hideCode && (framework !== 'vanilla' || jsCode) &&
  createEditor(
    `.${jsClass}`,
    {
      language: "javascript",
      value: `${_JS.trim()}`,
      theme: "github-dark",
      onUpdate(editedJS) {
        _JS = editedJS
        updateIframe()
      }
    },
    highlightBracketPairs(),
    matchTags(),
    defaultCommands(),
    matchBrackets(),
    indentGuides(),
    copyButton(),
    editHistory(),
  )
  
  function updateIframe() {
    renderCodeInIframe(_HTML, _CSS, _JS)
  }

  function frameworkSnippet (framework) {
    let url, html, app
    if (framework === 'vue') {
      url =  `<scr${'ipt'} crossorigin src="https://unpkg.com/vue@3/dist/vue.global.prod.js"></scr${'ipt'}>`
      html = 
`<div id="app">
  ${htmlCode.trim()}
</div>`
      app = 
`const { createApp } = Vue

const app = createApp(${jsCode ? jsCode.trim() : '{}'})

// Treat all tags starting with 'o-' as custom elements

app.config.compilerOptions.isCustomElement = (tag) => {
  return tag.startsWith('o-')
}
app.mount('#app')
      
`
  }

  if (framework === 'react') {
      url =  `<scr${'ipt'} crossorigin src="https://unpkg.com/react@18/umd/react.development.js"></scr${'ipt'}>
    <scr${'ipt'} crossorigin src="https://unpkg.com/react-dom@18/umd/react-dom.development.js"></scr${'ipt'}>
    <scr${'ipt'} crossorigin src="https://unpkg.com/@babel/standalone/babel.min.js"></scr${'ipt'}>
   `
      html = 
`<div id="app"></div>`
      app = 
`${jsCode ? jsCode.trim() : 'function App() {return (<div>empty</div>)}'}

// Render the component to the DOM
const container = document.getElementById('app');
const root = ReactDOM.createRoot(container);
root.render(<App />);
      
`
  }
    return {url, app, html}
  }
  
  function renderCodeInIframe(_HTML, _CSS, _JS) { 
    const orbit = 
      `<html style=" margin: 0 !important; padding: 0 !important">
        <head>
          <meta charset="UTF-8" />
          <meta name="viewport" content="width=device-width, initial-scale=1.0" />
          ${frame && frame.url ? frame.url : ''}
          <link rel="stylesheet" href="${orbitCSSUrl}">
          <style>
          body {
            font-family: "Noto Sans", sans-serif;
            font-optical-sizing: auto;
            font-weight: 500;
            font-style: normal;
            font-variation-settings: "wdth" 100;
            background-color: #fbfafa !important; 
            margin: 0 !important; 
            padding: 0 !important; 
            overflow: hidden
          }
          #app {
            height: ${height}
          }
          .bigbang {
            box-sizing: border-box;
          }
          ${_CSS}
          </style>
        </head>
        <body class="${theme}">
          ${_HTML}
          <scr${'ipt'} src="${orbitJSUrl}"></scr${'ipt'}>
          <scr${'ipt'} ${framework === 'react' ? 'type="text/babel"': ''}>
             ${_JS}
          </scr${'ipt'}>
        </body>
      </html>`
    const barebone = ` ${_HTML}`

    let iframeContent = frameTemplate === 'orbit' ? orbit : barebone
    // Copied starter markup uses public download URLs; previews use this build.
    iframeContent = iframeContent.replaceAll('https://zumerlab.github.io/orbit-docs/orbit/orbit.min.css', orbitCSSUrl)
      .replaceAll('https://zumerlab.github.io/orbit-docs/orbit/orbit.min.js', orbitJSUrl)

    const iframe = document.createElement('iframe')
    iframe.setAttribute('id', name)
    iframe.setAttribute('title', name)
    iframe.setAttribute('srcdoc', iframeContent)
    iframe.style.width = '100%'
    iframe.style.border = 'none'
    iframe.style.margin = '0'
    iframe.style.padding = '0'
    iframe.style.height = '100%' 
    const codeRenderer = document.querySelector(`#${name} .codeRenderer`)
    codeRenderer.innerHTML = ''
    codeRenderer.appendChild(iframe)
  }
    // Initially render the code of the active tabs
    updateIframe()
  </script>
<style>
  .runtime-note {
    margin-block: 0.6rem 1rem;
    font-size: 0.8rem;
    color: var(--sl-color-gray-2);
  }
  :global(.prism-code-editor) {
    max-height: 250px;
    border-radius: 5px;
  }
  .container {
    display: grid;
    grid-template-columns: 1fr;
    grid-template-rows: 1fr;
    padding: 5px;
    grid-template-areas: "preview";
    border: 1px solid #eaeaea;
    border-radius: 5px;
  }
  .preview {
    grid-area: preview;
    display: grid;
    grid-template-columns: 1fr;
    grid-template-rows: 1fr;
    
    grid-template-areas: "codeRenderer";
  }
  .codeRenderer {
    grid-area: codeRenderer;
    
    display: flex;
    justify-content: center;
    align-items: center;
  }
  .zeditor {
    max-height: 250px;
    border-radius: 5px;
  }
</style>
 