---
import PageFrame from '@astrojs/starlight/components/PageFrame.astro';
const isHomepage = Astro.locals.starlightRoute.id === '';
---

{isHomepage ? (
  <div class="orbit-home-frame"><slot /></div>
) : (
  <PageFrame>
    <slot name="header" slot="header" />
    <slot name="sidebar" slot="sidebar" />
    <slot />
  </PageFrame>
)}

<style is:global>
  body:has(.orbit-home-frame) { background: #060f16; }
  .orbit-home-frame .content-panel { padding: 0; border: 0; }
  .orbit-home-frame .sl-container { max-width: none; margin: 0; }
  .orbit-home-frame .sl-markdown { margin: 0; }
  .orbit-home-frame .right-sidebar-container { display: none; }
  .orbit-home-frame .main-pane { width: 100%; }
</style>
